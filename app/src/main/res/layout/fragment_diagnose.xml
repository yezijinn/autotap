<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <!-- 后端状态 -->
        <TextView
            style="@style/TextSectionTitle"
            android:text="@string/diagnose_section_backend" />

        <LinearLayout style="@style/CardStyle">

            <TextView
                style="@style/TextLabel"
                android:text="@string/diagnose_label_a11y" />

            <TextView
                android:id="@+id/text_a11y_state"
                style="@style/TextValue" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/diagnose_label_caps" />

            <TextView
                android:id="@+id/text_caps"
                style="@style/TextValue" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/diagnose_label_health" />

            <TextView
                android:id="@+id/text_health"
                style="@style/TextValue" />
        </LinearLayout>

        <!-- 鎾斁缁熻 -->
        <TextView
            style="@style/TextSectionTitle"
            android:text="@string/diagnose_section_playback" />

        <LinearLayout style="@style/CardStyle">

            <TextView
                style="@style/TextLabel"
                android:text="@string/diagnose_label_state" />

            <TextView
                android:id="@+id/text_play_state"
                style="@style/TextValue" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/diagnose_label_cycle" />

            <TextView
                android:id="@+id/text_cycle"
                style="@style/TextValue" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/diagnose_label_cursor" />

            <TextView
                android:id="@+id/text_cursor"
                style="@style/TextValue" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/diagnose_label_error" />

            <TextView
                android:id="@+id/text_last_error"
                style="@style/TextValue" />
        </LinearLayout>

        <!-- 璁惧淇℃伅 -->
        <TextView
            style="@style/TextSectionTitle"
            android:text="@string/diagnose_section_device" />

        <LinearLayout style="@style/CardStyle">

            <TextView
                style="@style/TextLabel"
                android:text="@string/diagnose_label_device" />

            <TextView
                android:id="@+id/text_device"
                style="@style/TextValue" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/diagnose_label_android" />

            <TextView
                android:id="@+id/text_android"
                style="@style/TextValue" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="@dimen/space_m"
                android:text="@string/diagnose_label_screen" />

            <TextView
                android:id="@+id/text_screen"
                style="@style/TextValue" />
        </LinearLayout>

        <!-- 抖动参数：运行时统计由 M4 接入 -->
        <TextView
            style="@style/TextSectionTitle"
            android:text="@string/diagnose_section_jitter" />

        <LinearLayout style="@style/CardStyle">

            <TextView
                android:id="@+id/text_jitter"
                style="@style/TextValue"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <!-- 淇濇椿鑷 -->
        <TextView
            style="@style/TextSectionTitle"
            android:text="@string/diagnose_section_selfcheck" />

        <LinearLayout style="@style/CardStyle">

            <TextView
                android:id="@+id/text_selfcheck_result"
                style="@style/TextValue"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/TextLabel"
                android:layout_marginTop="@dimen/space_s"
                android:lineSpacingExtra="3dp"
                android:text="@string/diagnose_selfcheck_hint" />

            <TextView
                android:id="@+id/btn_selfcheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_fab"
                android:gravity="center"
                android:paddingTop="@dimen/space_m"
                android:paddingBottom="@dimen/space_m"
                android:text="@string/diagnose_selfcheck_start"
                android:textColor="@color/overlay_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

