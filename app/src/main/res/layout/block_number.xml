<?xml version="1.0" encoding="utf-8"?>
<!-- 通用数字输入块：标签 + 输入框 + 单位提示，供「动作延迟」「本步循环」复用 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/text_number_label"
        style="@style/EditorFieldLabel"
        android:text="@string/editor_action_delay" />

    <EditText
        android:id="@+id/edit_number"
        style="@style/NumberField"
        android:layout_width="120dp"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m" />

    <TextView
        android:id="@+id/text_number_hint"
        style="@style/EditorFieldHint"
        android:layout_marginTop="@dimen/space_xs" />
</LinearLayout>
