<?xml version="1.0" encoding="utf-8"?>
<!-- 添加步骤：屏幕居中小卡片，四个类型竖向排列 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/add_step_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 半透明遮罩，点它关闭 -->
    <View
        android:id="@+id/add_step_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/record_scrim" />

    <!-- 居中卡片：竖向四选一 -->
    <LinearLayout
        android:id="@+id/add_step_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:minWidth="200dp"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog_card"
        android:padding="@dimen/space_m">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_add_step"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingBottom="@dimen/space_s" />

        <TextView
            android:id="@+id/item_add_tap"
            style="@style/EditorAddRow"
            android:text="@string/step_tap" />

        <TextView
            android:id="@+id/item_add_swipe"
            style="@style/EditorAddRow"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/step_swipe" />

        <TextView
            android:id="@+id/item_add_wait"
            style="@style/EditorAddRow"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/step_wait" />

        <TextView
            android:id="@+id/item_add_loop"
            style="@style/EditorAddRow"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/step_loop" />
    </LinearLayout>
</FrameLayout>
